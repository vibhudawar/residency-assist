# Copy to .env.local (cp env.template .env.local) and fill in. Never commit .env.local.

# ---------- ElevenLabs ----------
ELEVENLABS_API_KEY=
# Filled later, after we create the agent and import the Twilio number
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Post-call webhook signing secret (shown when the webhook is created)
ELEVENLABS_WEBHOOK_SECRET=

# ---------- Our backend ----------
# Secret header the agent's tools must send. Generate with: openssl rand -hex 32
TOOL_SHARED_SECRET=
APP_BASE_URL=http://localhost:3000

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---------- Twilio (SMS upload links) ----------
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# ---------- Demo ----------
# Your verified mobile, e.g. +91XXXXXXXXXX
DEMO_PHONE_NUMBER=
