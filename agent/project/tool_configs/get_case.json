{
  "type": "webhook",
  "name": "get_case",
  "description": "Get the problems found on this application, in plain words, with how each is resolved (fix_by_voice, upload, book_visit, route). Only after verify_identity returned verified: true.",
  "response_timeout_secs": 20,
  "interruption_mode": "allow",
  "pre_tool_speech": "auto",
  "tool_error_handling_mode": "auto",
  "api_schema": {
    "url": "https://{{system__env_app_host}}/api/tools/get_case",
    "method": "POST",
    "content_type": "application/json",
    "request_headers": {
      "x-tool-secret": {
        "env_var_label": "tool_shared_secret"
      },
      "x-case-token": {
        "variable_name": "secret__case_token"
      }
    },
    "request_body_schema": {
      "type": "object",
      "description": "Arguments for get_case.",
      "required": [],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
